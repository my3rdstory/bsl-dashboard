DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
# DEBUG=True 환경에서 라이트닝 인증 없이 페이크 일반회원 로그인 허용
DEBUG_FAKE_LIGHTNING_LOGIN=True
# DEBUG 페이크 로그인 시 지갑키 고정값 (재접속/브라우저 변경 후에도 같은 회원으로 테스트)
DEBUG_FAKE_LIGHTNING_FIXED_WALLET_KEY=
# 라이트닝 LNURL-auth 로그인 활성화
LNURL_AUTH_ENABLED=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# BLINK API Key 암호화 키 (미설정 시 DJANGO_SECRET_KEY 기반 키 사용)
BLINK_API_KEY_ENCRYPTION_KEY=
# BLINK GraphQL 엔드포인트 (운영: https://api.blink.sv/graphql, 스테이징: https://api.staging.blink.sv/graphql)
BLINK_GRAPHQL_ENDPOINT=https://api.blink.sv/graphql
# iwinv 오브젝트 스토리지(S3 호환) 설정
IWINV_OBJECT_STORAGE_ENDPOINT=https://kr.object.iwinv.kr
IWINV_OBJECT_STORAGE_BUCKET=bsl-dashboard
IWINV_OBJECT_STORAGE_ACCESS_KEY=
IWINV_OBJECT_STORAGE_SECRET_KEY=
IWINV_OBJECT_STORAGE_SIGNATURE_VERSION=s3
# 첨부파일 다운로드 임시 URL 만료(초)
IWINV_OBJECT_STORAGE_DOWNLOAD_EXPIRES=600
# 공유 메시지 알림 발신자 이메일
DEFAULT_FROM_EMAIL=noreply@bsl.local
# 지메일 SMTP 설정 (Google 계정 앱 비밀번호 사용 권장)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# 디스코드 채널 메시지 전송용 Bot Token
# 1) Discord Developer Portal에서 Bot 생성
# 2) 대상 서버에 Bot 초대 후 채널 Send Messages 권한 부여
# 3) Bot Token을 아래 값으로 설정
MESSAGE_SHARE_DISCORD_BOT_TOKEN=
# 온체인 확인 API 주소 (미설정 시 DEBUG=True는 testnet4, 아니면 mainnet 기본값 사용)
MEMPOOL_API_BASE_URL=
# 예시: 테스트넷4 고정
# MEMPOOL_API_BASE_URL=https://mempool.space/testnet4
# 예시: 메인넷 고정
# MEMPOOL_API_BASE_URL=https://mempool.space

# Render PostgreSQL 연결 시 DATABASE_URL 사용 (우선 적용)
DATABASE_URL=

POSTGRES_DB=bsl_dashboard
POSTGRES_USER=bsl_user
POSTGRES_PASSWORD=bsl_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
